 "overlays": [
  {
   "p": "は",
   "rule": "Replaces が and を. Stacks onto the others: には, では, からは.",
   "ex": {
    "n": "コーヒー は 飲{の}みません",
    "en": "Coffee, I don't drink",
    "jr": [
     [
      "O",
      "コーヒーは"
     ],
     [
      "V",
      "飲みません"
     ]
    ],
    "er": [
     [
      "O",
      "Coffee"
     ],
     [
      "V",
      "I don't drink"
     ]
    ]
   },
   "frame": "wa-ga"
  },
  {
   "p": "も",
   "rule": "Replaces が and を. Stacks onto the others: にも, でも.",
   "ex": {
    "n": "東京{とうきょう} に も 行{い}きました",
    "en": "I went to Tokyo too",
    "jr": [
     [
      "P",
      "東京にも"
     ],
     [
      "V",
      "行きました"
     ]
    ],
    "er": [
     [
      "V",
      "I went"
     ],
     [
      "P",
      "to Tokyo"
     ],
     [
      "V",
      "too"
     ]
    ]
   },
   "frame": "mo"
  },
  {
   "p": "だけ",
   "rule": "Only. Sits where the particle was; を and が usually drop away.",
   "ex": {
    "n": "水{みず} だけ 飲{の}みます",
    "en": "I only drink water",
    "jr": [
     [
      "O",
      "水だけ"
     ],
     [
      "V",
      "飲みます"
     ]
    ],
    "er": [
     [
      "V",
      "I only drink"
     ],
     [
      "O",
      "water"
     ]
    ]
   },
   "frame": "dake"
  },
  {
   "p": "しか",
   "rule": "Only, with a negative verb after it. Sounds like a complaint.",
   "ex": {
    "n": "水{みず} しか 飲{の}みません",
    "en": "I drink nothing but water",
    "jr": [
     [
      "O",
      "水しか"
     ],
     [
      "V",
      "飲みません"
     ]
    ],
    "er": [
     [
      "V",
      "I drink nothing but"
     ],
     [
      "O",
      "water"
     ]
    ]
   },
   "frame": "dake"
  }
 ],
 "pairs": [
  {
   "q": "は or が?",
   "a": "は sets up what you're talking about; が picks out which one. A question word and its answer both take が.",
   "frame": "wa-ga"
  },
  {
   "q": "に or で?",
   "a": "で is the stage an action happens on; に is the point something sits at or arrives at.",
   "frame": "ni-de"
  },
  {
   "q": "を or が?",
   "a": "Plain verbs take を. Potentials, 好き, 上手, ほしい and ある take が.",
   "frame": "o-ga"
  },
  {
   "q": "へ or に?",
   "a": "Both work with going verbs. へ leans towards the direction, に towards the destination you reach.",
   "frame": "direction"
  },
  {
   "q": "と or や?",
   "a": "と lists everything there is; や lists examples and implies more.",
   "frame": "to-ya"
  }
 ]
}