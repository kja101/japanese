{
 "intro": "Every slot in a Japanese sentence takes one of two or three markers. Learn the slot first, then the short list that can follow it, and most particle mistakes disappear. は and も sit on top of this: they replace が and を, but stack onto the others.",
 "slots": [
  {
   "role": "W",
   "label": "WHO / TOPIC",
   "jp": "は・が・も",
   "markers": [
    {
     "p": "は",
     "gloss": "the thing the sentence is about (the topic you have both agreed on)",
     "ex": {
      "n": "私{わたし} は 学生{がくせい} です",
      "en": "I'm a student",
      "jr": [
       [
        "W",
        "私は"
       ],
       [
        "V",
        "学生です"
       ]
      ],
      "er": [
       [
        "W",
        "I"
       ],
       [
        "V",
        "'m a student"
       ]
      ]
     },
     "frame": "desu"
    },
    {
     "p": "が",
     "gloss": "picks out which one: new information, and the answer to a question word",
     "ex": {
      "n": "だれ が 来{き}ます か",
      "en": "Who is coming?",
      "jr": [
       [
        "W",
        "だれが"
       ],
       [
        "V",
        "来ます"
       ],
       [
        "Q",
        "か"
       ]
      ],
      "er": [
       [
        "W",
        "Who"
       ],
       [
        "V",
        "is coming"
       ],
       [
        "Q",
        "?"
       ]
      ]
     },
     "frame": "dare-ga"
    },
    {
     "p": "も",
     "gloss": "too, as well; with a negative, either",
     "ex": {
      "n": "私{わたし} も 行{い}きます",
      "en": "I'm going too",
      "jr": [
       [
        "W",
        "私も"
       ],
       [
        "V",
        "行きます"
       ]
      ],
      "er": [
       [
        "W",
        "I"
       ],
       [
        "V",
        "'m going too"
       ]
      ]
     },
     "frame": "mo"
    }
   ]
  },
